{
	"name": "node-semantic-release",
	"version": "1.204.0",
	"description": "A semantic-release plugin to automate releases from a repository root.",
	"private": true,
	"scripts": {
		"preinstall": "npx npm-force-resolutions",
		"clean": "rm -rf node_modules dist package-lock.json",
		"clean-cache": "npm cache clean --force",
		"install:safe": "npm install --legacy-peer-deps --node-gyp=./node_modules/.bin/node-gyp",
		"build": "echo 'Nothing to build'"
	},
	"dependencies": {
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"semantic-release": "^25.0.8",
		"semantic-release-export-data": "^1.2.0"
	},
	"overrides": {
		"node-gyp": {
			"undici": ">=6.29.1 <7.0.0"
		},
		"@semantic-release/github": {
			"undici": ">=7.30.1 <8.0.0"
		},
		"@actions/http-client": {
			"undici": ">=6.29.1 <7.0.0"
		}
	}
}
